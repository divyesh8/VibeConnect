NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
ADMIN_ACCESS_TOKEN=
OPENAI_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Prefer a provider endpoint that issues short-lived (about 15 minute) credentials:
TURN_CREDENTIALS_URL=
TURN_CREDENTIALS_API_KEY=
# Server-only static coturn fallback. Never prefix these with NEXT_PUBLIC_:
TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
# Development only. Verifies TURN by allowing relay candidates only:
WEBRTC_FORCE_RELAY=false
NEXT_PUBLIC_WEBRTC_DIAGNOSTICS=false

# Legacy Supabase keys are also supported when your project still uses them:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
